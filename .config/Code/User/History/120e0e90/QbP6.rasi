* {
    green: 	                     #689d6a;	
    white:                       #ebdbb2;
    black:                       #1d2021;
    red:                         #cc241d;
    blue:                        #458588;
    unfocused:                   rgba(55, 55, 51, 1);

    foreground:                  @black;
    background:                  @white;
    foreground-normal:           @foreground;
    background-normal:           @background;
    foreground-urgent:           @green;
    background-urgent:           @background-normal;
    foreground-active:           @blue;
    background-active:           @background;
    foreground-select:           @black;
    background-select:           transparent;
    border:                      @red;
    font:                       "JetBrainsMono Nerd Font Mono semibold 12";
}

/* Window Configuration */
#window {
    fullscreen:         false;
    hide-scrollbar:     true;
    line-padding:       10;
    padding:            5px;
    width:              400px;
    location:           north;
    x-offset:           0px;
    y-offset:           3px;
    border-color:           @border;
    background-color:       @background;
    text-color:             @foreground;
}

/* Mainbox Configuration */
#mainbox {
    children:           [message, listview];
    border:             0;
    padding:            0;
    background-color:   @background;
}

/* Message Configuration */
#message {
    padding:            0px 1px 10px;
    border-color:       @background;
    background-color:   @background;
}

/* Listview Configuration */
#listview {
    fixed-height:       0;
    border:             2px 0px 0px;
    spacing:            3px;
    scrollbar:          false;
    padding:            1px 1px 1px;
    columns:            7;
    lines:              8;
    border-color:       @background;
    background-color:   @background;
}

/* Element Configuration */
#element {
    border:             0;
    padding:            8px 0px 0px;
    horizontal-align:   true;
    background-color:   @background;
}

/* Mode Switcher Configuration */
#mode-switcher {
    border:             0px 0px 0px;
}

/* Button Configuration */
#button {
    spacing:            0;
    text-color:         @foreground;
    background-color:   @background;
}

#button.selected {
    background-color:   @background;
    text-color:         @foreground;
}

#textbox {
    text-color: @foreground;
    background-color:   @background;
    font:               "JetBrainsMono Nerd Font Mono semibold 15";
}


#element.normal.normal {
    background-color: @background-normal;
    text-color:       @foreground-normal;
}
#element.normal.urgent {
    background-color: @background-urgent;
    text-color:       @foreground-urgent;
}
#element.normal.active {
    background-color: @background-active;
    text-color:       @foreground-active;
}
#element.selected.normal {
    background-color: @background-select;
    text-color:       @foreground-select;
}
#element.selected.urgent {
    background-color: @background-select;
    text-color:       @foreground-select;
}
#element.selected.active {
    background-color: @background-select;
    text-color:       @foreground-select;
}
#element.alternate.normal {
    background-color: @background-normal;
    text-color:       @foreground-normal;
}
#element.alternate.urgent {
    background-color: @background-urgent;
    text-color:       @foreground-urgent;
}
#element.alternate.active {
    background-color: @background-active;
    text-color:       @foreground-active;
}
#mode-switcher {
    border-color: @background;
    foreground-color:   @background;
    background-color:   @background;
}

#case-indicator {
    text-color: @foreground;
    background-color:   @background;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

