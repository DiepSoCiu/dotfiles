* {
 black:		#282828;
 red:		#cc241d;
 green:		#98971a;
 yellow:	#d79921;
 blue:		#458588;
 purple:	#b16286;
 aqua:		#689d6a;
 gray:		#a89984;
 brgray:	#928374;
 brred:		#fb4934;
 brgreen:	#b8bb26;
 bryellow:	#fabd2f;
 brblue:	#83a598;
 brpurple:	#d3869b;
 braqua:	#8ec07c;
 white:		#ebdbb2;
 bg1:       #3c3836;
 bg2:		#504945;
 unfocused: rgba(55, 55, 51, 1);
 black-90:  rgba(40,40,40,0.9);
 black-80:  rgba(40,40,40,0.8);
 black-70:  rgba(40,40,40,0.7);
 black-60:  rgba(40,40,40,0.6);
 black-50:  rgba(40,40,40,0.5);
 black-45:  rgba(40,40,40,0.45);
 black-40:  rgba(40,40,40,0.4);
 black-38:  rgba(40,40,40,0.38);
 black-36:  rgba(40,40,40,0.36);
 black-35:  rgba(40,40,40,0.35);
 black-34:  rgba(40,40,40,0.34);
 black-32:  rgba(40,40,40,0.32);
 black-30:  rgba(40,40,40,0.3);
 black-25:  rgba(40,40,40,0.25);
 black-20:  rgba(40,40,40,0.2);
 black-10:  rgba(40,40,40,0.1);


}
/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
    fake-transparency:          false;
}

/*****----- Global Properties -----*****/
* {
    font: "JetBrainsMono Nerd Font Mono semibold 11";
}

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    northeast;
    anchor:                      center;
    fullscreen:                  false;
    width:                       290px;
    x-offset:                    -3px;
    y-offset:                    3px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border-radius:               0px;
    border-color:                transparent;
    cursor:                      "default";
    background-color:            transparent;
}


/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     -3px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @white;
    background-color:            @black-40;
    children:                    ["mainboxb"];
}

/*****----- mainbox_clone-----*****/
mainboxb {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     3px;
    border:                      0px;
    border-radius:               5px;
    background-color:            @black-10;
    text-color:                  @white;
    children:                    ["mainboxc"];
}

mainboxc {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     3px;
    border:                      0px;
    border-radius:               5px;
    background-color:            @black-10;
    text-color:                  @white;
    children:                    [ "mainboxd"];
}

mainboxd {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     3px;
    border:                      0px;
    border-radius:               5px;
    background-color:            @black-20;
    text-color:                  @white;
    children:                    [ "mainboxe"];
}

mainboxe {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     3px;
    border:                      0px;
    border-radius:               5px;
    background-color:            @black-40;
    text-color:                  @white;
    children:                    [ "mainboxf"];
}

mainboxf {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     3px;
    border:                      0px;
    border-radius:               5px;
    background-color:            @black-50;
    text-color:                  @white;
    children:                    [ "mainboxg"];
}

mainboxg {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     3px;
    border:                      0px;
    border-radius:               5px;
    background-color:            @white;
    text-color:                  @black;
    children:                    [ "inputbar", "message", "listview"];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @black;
    children:                    [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "󰣇";
    padding:                     0px 16px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @black;
    font: "JetBrainsMono Nerd Font Mono bold 70";
}
prompt {
    enabled:                     true;
    padding:                     45px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @black;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0 0px 10px 10px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @black;
}
textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     12px;
    border:                      0px solid;
    border-radius:               0px;
    text-color:                  @black;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     5px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @black;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     1000px;
    border:                      0px solid;
    border-radius:               2px;
    background-color:            transparent;
    text-color:                  @black;
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
element selected.normal {
    background-color:            @unfocused;
    text-color:                  @white;
}
