{
    "workbench.productIconTheme": "material-product-icons",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.minimap.enabled": false,
    "breadcrumbs.enabled": false,
    "window.enableMenuBarMnemonics": false,
    "window.titleBarStyle": "native",
    "editor.fontFamily": "'JetBrains Mono Nerd Font', 'Symbols Nerd Font'",
    "editor.padding.bottom": 20,
    "editor.padding.top": 20,
    "workbench.statusBar.visible": false,
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "block",
    "workbench.editor.showTabs": "none",
    "workbench.activityBar.location": "bottom",
    "workbench.iconTheme": "gruvbox-material-icon-theme",
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.startupEditor": "none",
    "editor.stickyScroll.enabled": false,
    "window.customMenuBarAltFocus": false,
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "workbench.navigationControl.enabled": false,
    "window.menuStyle": "custom",
    "window.zoomLevel": 0.5,
    "editor.lineHeight": 1.8,
    "vscode-pets.theme": "forest",
    "vscode-pets.throwBallWithMouse": true,
    "vscode-pets.petSize": "small",
    "chat.commandCenter.enabled": false,
    "chat.disableAIFeatures": true,
    "window.restoreWindows": "none",
    "security.workspace.trust.enabled": false,
    "window.confirmSaveUntitledWorkspace": false,
    "editor.wordWrap": "on",
    "files.autoSave": "afterDelay",
    
    "latex-workshop.view.pdf.viewer": "external",
    "latex-workshop.view.pdf.external.viewer.command": "zathura",
    "latex-workshop.view.pdf.external.viewer.args": ["--synctex-editor-command", "code -g \"%{input}:%{line}\"","%PDF%" ],
     "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.synctex.path": "synctex",
    "latex-workshop.view.pdf.external.synctex.command": "zathura",
    "latex-workshop.view.pdf.external.synctex.args": ["--synctex-forward=%LINE%:0:%TEX%", "%PDF%"],
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "workbench.layoutControl.enabled": false,
    "workbench.editor.autoLockGroups": {
        "workbench.input.interactive": true
    },

}